<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BeckieDealApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeckieDealApp"
        tools:targetApi="31">
        <!-- Main Activity -->
        <activity
            android:name=".ui.activities.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".ui.activities.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.auth.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activities.auth.VerifyEmailOtpActivity"
            android:exported="false" />

        <!-- Product Activities -->
        <activity
            android:name=".ui.activities.product.CategoriesActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.activities.product.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product.AllBrandsActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.main.MainActivity" />
        <activity
            android:name=".ui.activities.product.AllBrandsActivityV2"
            android:exported="false"
            android:parentActivityName=".ui.activities.main.MainActivity" />
        <activity
            android:name=".ui.activities.product.CategoryDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product.ProductListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible" />

        <!-- Cart & Order Activities -->
        <activity
            android:name=".ui.activities.cart.CartActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.activities.cart.PayoutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.cart.MyOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.cart.OrderDetailActivity"
            android:exported="false" />
        
        <!-- Payment Activity with Deep Link Support -->
        <activity
            android:name=".ui.activities.payment.PaymentWebViewActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Deep links for payment result -->
                <data android:scheme="beckiedeal" android:host="payment" />
            </intent-filter>
        </activity>

        <!-- Profile Activities -->
        <activity
            android:name=".ui.activities.profile.ProfileActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.activities.profile.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.profile.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.profile.TermsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.profile.PrivacyPolicyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.profile.WishlistActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.activities.profile.CouponsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.profile.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileChangePasswordActivity"
            android:exported="false" />

        <!-- UI Components -->
        <activity
            android:name=".ui.components.ImageFullscreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.BeckieDealApp" />
    </application>

</manifest>
