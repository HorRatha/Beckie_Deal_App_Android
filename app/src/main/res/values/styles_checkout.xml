<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flat input box: label sits above the field, no floating hint -->
    <style name="Widget.App.CheckoutField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/checkout_field_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.App.CheckoutEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
