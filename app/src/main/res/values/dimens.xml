<?xml version="1.0" encoding="utf-8"?>
<!-- Compact phone baseline (< 360dp smallest width) -->
<resources>

    <!-- ============================================================
         TYPE SCALE  —  single source of truth for every text size.
         Buckets: values/ (<360dp)  values-sw360dp/  values-sw600dp/  values-sw900dp/
         Never hardcode "sp" in a layout; always use one of these.
         ============================================================ -->

    <!-- Counters inside fixed-size badge circles. Scales the least on purpose
         so the number never outgrows its container. -->
    <dimen name="text_size_badge">9sp</dimen>
    <!-- Micro uppercase labels, ratings, chip eyebrows -->
    <dimen name="text_size_overline">9sp</dimen>
    <!-- Metadata, helper text, timestamps, secondary chips -->
    <dimen name="text_size_caption">11sp</dimen>
    <!-- Default body copy and list labels -->
    <dimen name="text_size_body">13sp</dimen>
    <!-- Emphasised body: prices, inputs, drawer menu items -->
    <dimen name="text_size_body_large">15sp</dimen>
    <!-- Card titles and in-card section headers -->
    <dimen name="text_size_title_small">17sp</dimen>
    <!-- Screen section titles ("Featured Products") -->
    <dimen name="text_size_title">18sp</dimen>
    <!-- Banner / stat headlines -->
    <dimen name="text_size_headline">20sp</dimen>
    <!-- Hero headlines on category + about screens -->
    <dimen name="text_size_headline_large">23sp</dimen>
    <!-- Auth / brand display titles -->
    <dimen name="text_size_display">25sp</dimen>

    <!-- Legacy aliases kept so existing names stay valid -->
    <dimen name="section_title_size">@dimen/text_size_title</dimen>
    <dimen name="section_subtitle_size">@dimen/text_size_caption</dimen>
    <dimen name="page_title_size">@dimen/text_size_headline</dimen>

    <!-- Hero banners -->
    <dimen name="hero_banner_height">180dp</dimen>
    <dimen name="hero_banner_height_detail">160dp</dimen>
    <dimen name="hero_banner_height_product">340dp</dimen>

    <!-- Product grid -->
    <dimen name="product_grid_columns">2</dimen>   <!-- informational only, used in Java -->
    <dimen name="product_image_height">150dp</dimen>
    <dimen name="product_card_margin">6dp</dimen>

    <!-- Horizontal scroll card -->
    <dimen name="h_card_width">165dp</dimen>
    <dimen name="h_card_height">220dp</dimen>
    <dimen name="h_card_image_height">120dp</dimen>

    <!-- Category grid card -->
    <dimen name="category_card_height">150dp</dimen>

    <!-- Toolbar -->
    <dimen name="toolbar_height">64dp</dimen>

    <!-- Spacing -->
    <dimen name="page_margin">16dp</dimen>
    <dimen name="card_inner_padding">12dp</dimen>
    <dimen name="section_spacing">24dp</dimen>

    <!-- Shared capsule geometry for compact filter and category chips. -->
    <dimen name="chip_pill_radius">20dp</dimen>
    <dimen name="chip_stroke_width">1dp</dimen>

    <!-- Oversized radius is clamped to half the button height, creating a capsule. -->
    <dimen name="button_pill_radius">999dp</dimen>

    <!-- Bottom nav pill margins -->
    <dimen name="bottom_nav_side_margin">0dp</dimen>
    <dimen name="bottom_nav_bottom_margin">0dp</dimen>
    <dimen name="bottom_nav_corner_radius">0dp</dimen>
</resources>
