<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BeckieDealApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.ScreenTitle</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.ProductName</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.PriceHero</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.SectionHeader</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.CardProductName</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Specs</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Button</item>
        
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">22dp</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <!-- Suppress Material3's internal surface tint so our pill bg is the only layer -->
        <item name="android:background">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.ActiveIndicator</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
    </style>

    <!-- Clean pill indicator — solid orange tint, no border noise -->
    <style name="Widget.App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator_fill</item>
        <item name="android:width">80dp</item>
        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomNav.ActiveIndicator</item>
    </style>

    <style name="ShapeAppearance.App.BottomNav.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.BeckieDealApp" parent="Base.Theme.BeckieDealApp">
        <item name="buttonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Shared capsule shape for all primary action buttons. -->
    <style name="ShapeAppearance.App.Button.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Tab text style for orders screen -->
    <style name="Tab.OrderText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/synonym_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Custom Alert Dialog with rounded corners and better styling -->
    <style name="Theme.MaterialComponents.DayNight.Dialog.Alert.Rounded" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Dialog.Outlined</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Button.Dialog.Text</item>
    </style>

    <!-- Rounded corners for dialogs -->
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Dialog title style -->
    <style name="MaterialAlertDialog.App.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/amulya_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Dialog body style -->
    <style name="MaterialAlertDialog.App.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/synonym_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
    </style>

    <!-- Dialog button styles -->
    <style name="Widget.App.Button.Dialog" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white_fixed</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button.Pill</item>
    </style>

    <style name="Widget.App.Button.Dialog.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button.Pill</item>
    </style>

    <style name="Widget.App.Button.Dialog.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>