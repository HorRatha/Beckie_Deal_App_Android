<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/bottom_nav_cart_bold"
        android:state_checked="true"
        android:drawable="@drawable/shopping_cart_24" />
    <item
        android:id="@+id/bottom_nav_cart_thin"
        android:drawable="@drawable/shopping_cart_24_thin" />
    <transition
        android:fromId="@id/bottom_nav_cart_thin"
        android:toId="@id/bottom_nav_cart_bold"
        android:drawable="@drawable/bottom_nav_cart_transition"
        android:reversible="true" />
</animated-selector>