<?xml version="1.0" encoding="utf-8"?>
<!-- Feature card with gradient border and white inner background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFEC0F"
                android:centerColor="#FDC011"
                android:endColor="#F07615"
                android:centerX="0.20"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Inner white background with padding to show border -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
