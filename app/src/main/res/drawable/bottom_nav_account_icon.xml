<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/bottom_nav_account_bold"
        android:state_checked="true"
        android:drawable="@drawable/ic_account" />
    <item
        android:id="@+id/bottom_nav_account_thin"
        android:drawable="@drawable/ic_account_thin" />
    <transition
        android:fromId="@id/bottom_nav_account_thin"
        android:toId="@id/bottom_nav_account_bold"
        android:drawable="@drawable/bottom_nav_account_transition"
        android:reversible="true" />
</animated-selector>