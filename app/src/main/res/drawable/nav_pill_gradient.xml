<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation pill gradient: Yellow to Orange (Top-left to Bottom-right) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#FFEC0F"
        android:centerColor="#FDC011"
        android:endColor="#F07615"
        android:centerX="0.20"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
