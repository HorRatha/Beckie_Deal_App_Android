<?xml version="1.0" encoding="utf-8"?>
<!--
    Active-item pill indicator — a frosted orange tint with a soft border,
    matching the iOS 26 "filled glass chip" style.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_indicator_fill" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_indicator_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
