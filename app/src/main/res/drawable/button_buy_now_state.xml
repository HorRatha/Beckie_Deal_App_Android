<?xml version="1.0" encoding="utf-8"?>
<!-- Buy Now button with state selector: Dark gray default, yellow on pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/clicked state - yellow -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFEC0F" />
            <corners android:radius="@dimen/button_pill_radius" />
        </shape>
    </item>
    
    <!-- Focused state - yellow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFEC0F" />
            <corners android:radius="@dimen/button_pill_radius" />
        </shape>
    </item>
    
    <!-- Default state - dark gray -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2F3130" />
            <corners android:radius="@dimen/button_pill_radius" />
        </shape>
    </item>
</selector>
