<?xml version="1.0" encoding="utf-8"?>
<!-- Buy Now Glass Morphism button selector: Dark gray with glass effect, yellow on pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/clicked state - yellow glass -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#F0FFEC0F" />
                    <corners android:radius="@dimen/button_pill_radius" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#CCFFEC0F" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused state - yellow glass -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#F0FFEC0F" />
                    <corners android:radius="@dimen/button_pill_radius" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#CCFFEC0F" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default state - dark gray glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E02F3130" />
                    <corners android:radius="@dimen/button_pill_radius" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#662F3130" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
