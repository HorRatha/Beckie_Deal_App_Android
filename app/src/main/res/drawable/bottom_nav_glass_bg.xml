<?xml version="1.0" encoding="utf-8"?>
<!--
    iOS-style floating glass pill.
    Nearly transparent — only a hairline border and a barely-there white tint
    so the page content shows through, like iOS's springboard dock.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Very thin white tint — just enough to lift it off the page -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_glass_fill" />
            <corners android:radius="@dimen/bottom_nav_corner_radius" />
        </shape>
    </item>

    <!-- Hairline border — the only visible "edge" of the pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_glass_border" />
            <corners android:radius="@dimen/bottom_nav_corner_radius" />
        </shape>
    </item>

</layer-list>
