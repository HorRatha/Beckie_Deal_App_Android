<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400"
    android:interpolator="@interpolator/bottom_nav_emphasized">
    <propertyValuesHolder
        android:propertyName="alpha"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.08" android:value="0" />
        <keyframe android:fraction="0.45" android:value="0.95" />
        <keyframe android:fraction="0.62" android:value="1" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.72" />
        <keyframe android:fraction="0.58" android:value="1.1" />
        <keyframe android:fraction="0.82" android:value="0.98" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.72" />
        <keyframe android:fraction="0.58" android:value="1.1" />
        <keyframe android:fraction="0.82" android:value="0.98" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="translateY"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="1.5" />
        <keyframe android:fraction="0.58" android:value="-1" />
        <keyframe android:fraction="0.82" android:value="0.15" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>