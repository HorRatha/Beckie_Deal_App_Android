<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ProfileActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ── Scrollable body ─────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <!-- ── Header Container (Wave + Toolbar + Avatar) ──────────────── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- ── Wave background header ────────────────────────────────────────── -->
                <ImageView
                    android:id="@+id/bgWave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_top_wave"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/heroGradient"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:layout_editor_absoluteX="0dp" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/topAppBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_height"
                    android:background="@color/topbar_yellow_transparent"
                    android:elevation="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:id="@+id/menuIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="9dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/circle_white_translucent"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="@color/white_fixed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="Profile"
                            android:textAppearance="@style/TextAppearance.App.SectionHeader"
                            android:textColor="@color/white_fixed" />

                        <RelativeLayout
                            android:id="@+id/notificationContainer"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/notificationIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/dark_brown" />

                            <TextView
                                android:id="@+id/notificationBadge"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/badge_pill"
                                android:backgroundTint="@color/red_error"
                                android:gravity="center"
                                android:text="3"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textAllCaps="false"
                                android:textColor="@color/white_fixed"
                                android:visibility="visible" />
                        </RelativeLayout>
                    </RelativeLayout>
                </com.google.android.material.appbar.MaterialToolbar>

                <!-- ══ FLOATING AVATAR ═══════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/avatarOverlay"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:elevation="20dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="20dp"
                    app:strokeWidth="4dp"
                    app:strokeColor="@color/dark_brown"
                    app:cardBackgroundColor="@color/card_bg_secondary"
                    app:layout_constraintTop_toBottomOf="@id/heroGradient"
                    app:layout_constraintBottom_toBottomOf="@id/heroGradient"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.25"
                    app:layout_constraintVertical_bias="0.15">

                    <!-- WebView to display DiceBear SVG avatar -->
                    <WebView
                        android:id="@+id/avatarWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent" />
                    
                    <!-- Fallback ImageView if WebView fails to load -->
                    <ImageView
                        android:id="@+id/avatarIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/editAvatarButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="22dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="22dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/surface"
                    app:cardBackgroundColor="@color/primary"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginBottom="-4dp"
                    app:layout_constraintBottom_toBottomOf="@id/avatarOverlay"
                    app:layout_constraintEnd_toEndOf="@id/avatarOverlay">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit_profile" />
                </com.google.android.material.card.MaterialCardView>

                <!-- User Name -->
                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hor Ratha"
                    android:textAppearance="@style/TextAppearance.App.ProductName"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@id/avatarOverlay"
                    app:layout_constraintStart_toEndOf="@id/avatarOverlay"
                    app:layout_constraintBottom_toBottomOf="@id/avatarOverlay"
                    app:layout_constraintVertical_bias="0.3" />

                <!-- User Email / Subtitle -->
                <TextView
                    android:id="@+id/userEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="horratha45@gmail.com"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/userName"
                    app:layout_constraintStart_toEndOf="@id/avatarOverlay" />



            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ══ SCROLLABLE IDENTITY HEADER ════════════════════════════ -->

            <!-- ══ BENTO TILES + NOTIFICATIONS + AUTH BUTTONS ══ -->
            <LinearLayout
                android:id="@+id/profileHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_margin"
                android:paddingTop="20dp"
                android:paddingBottom="0dp">

                <!-- Everything shown only when logged in (toggle this from code) -->
                <LinearLayout
                    android:id="@+id/loggedInTiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Bento row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Left: My Orders (tall, brand gradient) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/myOrdersBox"
                            android:layout_width="0dp"
                            android:layout_height="160dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_bento_gradient"
                                android:gravity="bottom"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:id="@+id/activeOrdersCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3"
                                    android:textColor="@color/dark_brown"
                                    android:textSize="40sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="My Orders"
                                    android:textAllCaps="false"
                                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                                    android:textColor="@color/dark_brown" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:alpha="0.8"
                                    android:text="active now"
                                    android:textAppearance="@style/TextAppearance.App.Body"
                                    android:textColor="@color/dark_brown" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Right: Coupons + Edit Profile stacked -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="160dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- My Coupons -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/myCouponsBox"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginBottom="6dp"
                                android:layout_weight="1"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="0dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/border_color"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="12dp">

                                    <TextView
                                        android:id="@+id/couponsCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="4"
                                        android:textColor="@color/brand_orange"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="My Coupons"
                                            android:textAllCaps="false"
                                            android:textAppearance="@style/TextAppearance.App.Label"
                                            android:textColor="@color/text_primary" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="available"
                                            android:textAppearance="@style/TextAppearance.App.Body"
                                            android:textColor="@color/text_secondary" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Edit Profile -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/editProfileBox"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="0dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/border_color"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="12dp">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_edit_profile"
                                        app:tint="@color/brand_orange" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:layout_weight="1"
                                        android:text="Edit Profile"
                                        android:textAllCaps="false"
                                        android:textAppearance="@style/TextAppearance.App.Label"
                                        android:textColor="@color/text_primary" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_chevron_right"
                                        app:tint="@color/text_secondary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Notifications tile (full width, same IDs as before) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_spacing"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/notificationsRow"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="11dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_notifications"
                                    app:tint="@color/brand_tint_fg_3" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="Notifications"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/text_primary" />

                            <!-- Segmented Pill Toggle (ON / OFF) - unchanged -->
                            <LinearLayout
                                android:id="@+id/notifToggleContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/notification_toggle_bg"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="3dp">

                                <FrameLayout
                                    android:id="@+id/notifOnOption"
                                    android:layout_width="40dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/notification_pill_active"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/notifOnIcon"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_toggle_on"
                                        app:tint="@color/white_fixed" />
                                </FrameLayout>

                                <FrameLayout
                                    android:id="@+id/notifOffOption"
                                    android:layout_width="40dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/notification_pill_inactive"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/notifOffIcon"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_toggle_off"
                                        app:tint="@color/text_secondary" />
                                </FrameLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Auth buttons (guests) - unchanged -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_add_to_cart_glass"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.App.Button"
                        android:textColor="@color/dark_brown"
                        android:visibility="gone"
                        app:backgroundTint="@null"
                        app:elevation="0dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_buy_now_glass"
                        android:text="Register"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.App.Button"
                        android:textColor="@color/white_fixed"
                        android:visibility="gone"
                        app:backgroundTint="@null"
                        app:elevation="0dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ PREFERENCES + LEGAL (flat cards) - this layout stays open for Logout and the footer ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_margin"
                android:paddingTop="0dp"
                android:paddingBottom="24dp">

                <!-- ══ PREFERENCES SECTION ════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.08"
                    android:text="Preferences"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Dark Mode toggle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardCornerRadius="11dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@android:color/transparent">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_dark_mode"
                                    app:tint="@color/brand_tint_fg_5" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="Dark Mode"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/text_primary" />

                            <!-- Segmented Pill Toggle (Sun / Moon) -->
                            <LinearLayout
                                android:id="@+id/darkModeToggleContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/dark_mode_toggle_bg"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="3dp">

                                <FrameLayout
                                    android:id="@+id/lightModeOption"
                                    android:layout_width="40dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/dark_mode_pill_active"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/lightModeIcon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_sun"
                                        app:tint="@color/white_fixed" />
                                </FrameLayout>

                                <FrameLayout
                                    android:id="@+id/darkModeOption"
                                    android:layout_width="40dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/dark_mode_pill_inactive"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/darkModeIcon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_moon"
                                        app:tint="@color/text_secondary" />
                                </FrameLayout>

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ LEGAL ══ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.08"
                    android:text="Legal"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- About Us -->
                        <LinearLayout
                            android:id="@+id/aboutUsRow"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardCornerRadius="11dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@android:color/transparent">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_info"
                                    app:tint="@color/brand_tint_fg_2" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="About Us"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/text_primary" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                        <!-- Privacy Policy -->
                        <LinearLayout
                            android:id="@+id/privacyRow"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardCornerRadius="11dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@android:color/transparent">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_privacy"
                                    app:tint="@color/brand_tint_fg_6" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="Privacy Policy"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/text_primary" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                        <!-- Terms of Service -->
                        <LinearLayout
                            android:id="@+id/termsRow"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardCornerRadius="11dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@android:color/transparent">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_terms"
                                    app:tint="@color/brand_tint_fg_1" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="Terms of Service"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/text_primary" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LOGOUT BUTTON (shown only when logged in) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginBottom="0dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.App.Button"
                    android:textColor="@color/white_fixed"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/red_error"
                    app:cornerRadius="@dimen/button_pill_radius"
                    app:elevation="4dp"
                    app:strokeWidth="0dp" />

                <!-- ══ VERSION FOOTER ══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginBottom="@dimen/section_spacing"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/ic_launcher"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Beckie Deal"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Version 1.0.0"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Floating bottom nav ─────────────────────────────────────────── -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>

<include layout="@layout/layout_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
