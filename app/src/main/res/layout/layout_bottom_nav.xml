<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom bottom navigation — expandable tabs with smooth reflow.
    Selected item shows icon + label; others collapse to icon-only.
    Uses weighted layout for smooth space redistribution.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavGlassHost"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/bottom_nav_side_margin"
    android:layout_marginEnd="@dimen/bottom_nav_side_margin"
    android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
    android:background="@drawable/bottom_nav_glass_bg"
    android:clipToOutline="true"
    android:elevation="4dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:weightSum="5.5">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navItemHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/navPillHome"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/nav_pill_background">

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottom_nav_home_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:alpha="0"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Categories -->
        <LinearLayout
            android:id="@+id/navItemCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/navPillCategories"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/nav_pill_background">

                <ImageView
                    android:id="@+id/navIconCategories"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottom_nav_categories_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/navLabelCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Categories"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:alpha="0"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Favorites -->
        <LinearLayout
            android:id="@+id/navItemFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/navPillFavorites"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/nav_pill_background">

                <ImageView
                    android:id="@+id/navIconFavorites"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottom_nav_favorites_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/navLabelFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Favorites"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:alpha="0"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cart -->
        <LinearLayout
            android:id="@+id/navItemCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/navPillCart"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/nav_pill_background">

                <ImageView
                    android:id="@+id/navIconCart"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottom_nav_cart_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/navLabelCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Cart"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:alpha="0"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Account -->
        <LinearLayout
            android:id="@+id/navItemAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/navPillAccount"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/nav_pill_background">

                <ImageView
                    android:id="@+id/navIconAccount"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottom_nav_account_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/navLabelAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Account"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:alpha="0"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
