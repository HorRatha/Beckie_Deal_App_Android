<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared bottom navigation bar — full-width, flush at bottom.
    Rounded top corners only. No floating margins, no background bleed.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavGlassHost"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/bottom_nav_side_margin"
    android:layout_marginEnd="@dimen/bottom_nav_side_margin"
    android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
    android:background="@drawable/bottom_nav_glass_bg"
    android:clipToOutline="true"
    android:elevation="4dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        app:backgroundTint="@android:color/transparent"
        app:elevation="0dp"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="26dp"
        app:itemRippleColor="@color/nav_indicator_fill"
        app:itemActiveIndicatorStyle="@style/Widget.App.BottomNav.ActiveIndicator"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemIconTint="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</FrameLayout>
