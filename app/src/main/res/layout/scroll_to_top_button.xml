<?xml version="1.0" encoding="utf-8"?>
<!--
    Scroll to Top Button - Floating action button to return to top of page
    Shows when user scrolls down, hides when at top
    Smooth fade in/out animation
-->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_gravity="bottom|end"
    android:layout_margin="16dp"
    android:src="@drawable/ic_arrow_up"
    android:contentDescription="Scroll back to top"
    app:fabSize="normal"
    app:fabCustomSize="56dp"
    app:borderWidth="0dp"
    app:elevation="8dp"
    app:backgroundTint="@color/brand_orange"
    app:tint="@color/white_fixed" />
