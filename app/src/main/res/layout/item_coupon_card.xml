<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/primary"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Section: Code + Discount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Dashed Border Icon Container -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/coupon_icon_bg">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_discount_tag"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/couponCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME10"
                    android:textAppearance="@style/TextAppearance.App.SectionHeader"
                    android:fontFamily="monospace" />
                
                <TextView
                    android:id="@+id/couponDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="10% OFF"
                    android:textAppearance="@style/TextAppearance.App.PriceHero"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/couponDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="10% off for new users"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/border_color" />

        <!-- Bottom Section: Min Purchase + Copy Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_muted" />
                
                <TextView
                    android:id="@+id/couponMinPurchase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="No minimum"
                    android:textAppearance="@style/TextAppearance.App.Body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyCouponButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Copy Code"
                android:backgroundTint="@color/primary"
                android:paddingHorizontal="20dp"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.App.CardProductName"
                android:textColor="@color/white_fixed"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_copy"
                app:iconTint="@color/white_fixed"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
