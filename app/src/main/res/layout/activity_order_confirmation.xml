<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Progress Loading -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:indeterminate="true" />

    <!-- Success Icon -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="✓"
        android:textSize="60sp"
        android:textColor="@color/green_stock"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Confirmation Message -->
    <TextView
        android:id="@+id/text_confirmation_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thank You!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Order Number -->
    <TextView
        android:id="@+id/text_order_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order #123456"
        android:textSize="16sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:textStyle="bold" />

    <!-- Order Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_order_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Info Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A confirmation email has been sent to your email address"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Track Order Button -->
    <Button
        android:id="@+id/btn_track_order"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Track Order"
        android:background="@color/primary"
        android:textColor="@color/black_fixed"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Continue Shopping Button -->
    <Button
        android:id="@+id/btn_continue_shopping"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Continue Shopping"
        android:background="@color/input_background"
        android:textColor="@color/primary" />
</LinearLayout>
