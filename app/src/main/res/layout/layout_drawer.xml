<?xml version="1.0" encoding="utf-8"?>
<!--
    Side drawer panel — used by all activities via AppDrawerHelper.
    Width is fixed at 300dp so it never covers the full screen.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerPanel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/surface"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ── Header Container with Swoosh Art Outside RelativeLayout ──────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <!-- Header Card Layout with Background and Padding -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sidebar_header_full_bg"
            android:clipToOutline="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="20dp">

            <!-- Horizontal layout: Avatar on left, text on right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/drawerAvatarCard"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/primary"
                    app:cardBackgroundColor="@color/dark_brown">

                    <!-- WebView to display DiceBear SVG avatar -->
                    <WebView
                        android:id="@+id/drawerAvatarWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Text container next to avatar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <!-- Welcome back message for logged-in users -->
                    <TextView
                        android:id="@+id/drawerWelcomeBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/white_fixed"
                        android:alpha="0.8"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/drawerUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Guest User"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/white_fixed" />

                    <TextView
                        android:id="@+id/drawerUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sign in to your account"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/white_fixed"
                        android:alpha="0.8" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Background swoosh art placed OUTSIDE the RelativeLayout in top-end corner -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="71dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_card_swoosh" />

    </FrameLayout>

    <!-- ── Scrollable menu items ────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/drawerHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Home"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Categories -->
            <LinearLayout
                android:id="@+id/drawerCategories"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/category_search_24"
                    android:contentDescription="Categories"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Categories"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- My Orders -->
            <LinearLayout
                android:id="@+id/drawerOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_orders"
                    android:contentDescription="My Orders"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Orders"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- My Coupons -->
            <LinearLayout
                android:id="@+id/drawerWishlist"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Wishlist"
                    android:src="@drawable/ic_favorite"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Wishlist"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
                <!-- Live wishlist count badge -->
                <TextView
                    android:id="@+id/drawerWishlistBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/badge_pill"
                    android:backgroundTint="@color/red_error"
                    android:gravity="center"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/white_fixed"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerCoupons"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/star_shine_24"
                    android:contentDescription="My Coupons"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Coupons"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />

            </LinearLayout>

            <!-- My Reviews -->
            <LinearLayout
                android:id="@+id/drawerReviews"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/reviews_24"
                    android:contentDescription="My Reviews"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Reviews"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Wishlist -->

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/border_color" />

            <!-- Edit Profile -->
            <LinearLayout
                android:id="@+id/drawerEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/person_edit_24"
                    android:contentDescription="Edit Profile"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Edit Profile"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/drawerNotifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifications"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Notifications"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Dark Mode toggle row -->
            <LinearLayout
                android:id="@+id/drawerDarkMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_dark_mode"
                    android:contentDescription="Dark Mode"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Dark Mode"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/drawerDarkModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/border_color" />

            <!-- Privacy Policy -->
            <LinearLayout
                android:id="@+id/drawerPrivacy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_privacy"
                    android:contentDescription="Privacy Policy"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Privacy Policy"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Terms of Service -->
            <LinearLayout
                android:id="@+id/drawerTerms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_terms"
                    android:contentDescription="Terms of Service"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Terms of Service"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- About Us -->
            <LinearLayout
                android:id="@+id/drawerAbout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="About Us"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="About Us"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Login / Register (shown only when not logged in) -->
            <LinearLayout
                android:id="@+id/drawerLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:id="@+id/drawerLoginIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_account"
                    android:contentDescription="Login"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/drawerLoginLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Login / Register"
                    android:textAppearance="@style/TextAppearance.App.CardProductName" />
            </LinearLayout>

            <!-- Logout (shown only when logged in) -->
            <LinearLayout
                android:id="@+id/drawerLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_logout"
                    android:contentDescription="Logout"
                    app:tint="@color/red_error" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Logout"
                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                    android:textColor="@color/red_error" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Footer version tag ─────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="TechStore v1.0"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textAllCaps="false"
        android:textColor="@color/text_muted" />

</LinearLayout>
