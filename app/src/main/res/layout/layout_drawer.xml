<?xml version="1.0" encoding="utf-8"?>
<!--
    Side drawer panel — used by all activities via AppDrawerHelper.
    Width is fixed at 300dp so it never covers the full screen.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerPanel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/surface"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- Avatar circle -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/about_icon_circle_bg"
            android:gravity="center">
            <ImageView
                android:id="@+id/drawerAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_person"
                android:contentDescription="User avatar"
                app:tint="@color/white_fixed" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawerUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Guest User"
            android:textColor="@color/white_fixed"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawerUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sign in to your account"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- ── Scrollable menu items ────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/drawerHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Home"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Categories -->
            <LinearLayout
                android:id="@+id/drawerCategories"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/category_search_24"
                    android:contentDescription="Categories"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Categories"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- My Orders -->
            <LinearLayout
                android:id="@+id/drawerOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_orders"
                    android:contentDescription="My Orders"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Orders"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Favorites -->
            <LinearLayout
                android:id="@+id/drawerFavorites"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_favorite"
                    android:contentDescription="Favorites"
                    app:tint="@color/primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <!-- Live favorites count badge -->
                <TextView
                    android:id="@+id/drawerFavBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/badge_pill"
                    android:backgroundTint="@color/red_error"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white_fixed"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/border_color" />

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/drawerNotifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifications"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Dark Mode toggle row -->
            <LinearLayout
                android:id="@+id/drawerDarkMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_dark_mode"
                    android:contentDescription="Dark Mode"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Dark Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/drawerDarkModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Language -->
            <LinearLayout
                android:id="@+id/drawerLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_language"
                    android:contentDescription="Language"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Language"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/drawerLanguageValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/border_color" />

            <!-- About Us -->
            <LinearLayout
                android:id="@+id/drawerAbout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="About Us"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="About Us"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Login / Logout -->
            <LinearLayout
                android:id="@+id/drawerLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/drawer_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:id="@+id/drawerLoginIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_account"
                    android:contentDescription="Login"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/drawerLoginLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Login / Register"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Footer version tag ───────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="TechStore v1.0"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
