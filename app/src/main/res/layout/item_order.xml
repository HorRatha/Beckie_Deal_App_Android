<?xml version="1.0" encoding="utf-8"?>
<!--
    Order card â€” matches existing card style (16dp corners, 1dp border, 0dp elevation).
    Shows order ID, date, status badge, item thumbnails strip, and total.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_color"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Order ID + Status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/orderIdText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order #BD-1001"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/order_status_badge_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Processing"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Row 2: Date + item count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/orderDateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jul 13, 2026"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/orderItemCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 items"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/border_color" />

        <!-- Row 3: Product thumbnails strip -->
        <LinearLayout
            android:id="@+id/orderThumbnailStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <!-- Row 4: Total + View Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/orderTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="$0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/viewDetailsButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/form_field_background"
                android:paddingHorizontal="16dp"
                android:text="View Details"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
