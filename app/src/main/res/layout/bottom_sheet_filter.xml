<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingBottom="32dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/badge_pill"
        android:backgroundTint="#DDDDDD" />

    <!-- Header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Filter &amp; Sort"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Reset"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- ══ SORT BY ══════════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:text="Sort By"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- Scrollable so chips never wrap/overflow -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/sortContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/sortDefault"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Default"
                android:textSize="13sp"
                android:singleLine="true"
                android:background="@drawable/chip_selected"
                android:textColor="@color/white_fixed" />

            <TextView
                android:id="@+id/sortPriceLow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Price: Low → High"
                android:textSize="13sp"
                android:singleLine="true"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/sortPriceHigh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Price: High → Low"
                android:textSize="13sp"
                android:singleLine="true"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/sortTopRated"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Top Rated"
                android:textSize="13sp"
                android:singleLine="true"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/border_color" />

    <!-- ══ RELEASE YEAR ═════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:text="Release Year"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/yearContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />

    </HorizontalScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/border_color" />

    <!-- ══ PRICE RANGE ══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp"
        android:text="Price Range"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- Live price label centred above slider -->
    <TextView
        android:id="@+id/priceRangeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@drawable/chip_selected"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="$0 – $3,000"
        android:textColor="@color/white_fixed"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Slider -->
    <SeekBar
        android:id="@+id/priceSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:max="3000"
        android:progress="3000"
        android:progressTint="@color/primary"
        android:thumbTint="@color/primary" />

    <!-- Min / Max labels below slider -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/priceMinLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="$0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/priceMaxLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="$3,000"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </RelativeLayout>

    <!-- ══ APPLY BUTTON ═════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/primary"
        android:text="Apply Filters"
        android:textColor="@color/white_fixed"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</LinearLayout>
