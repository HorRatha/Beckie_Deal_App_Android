<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".CategoryDetailActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/topbar_yellow_transparent"
        app:contentInsetStart="0dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="Back"
                app:tint="@color/dark_brown" />

            <!-- Category name title -->
            <TextView
                android:id="@+id/categoryTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Category"
                android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            <!-- Category image icon - wallet section -->

        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <!-- Hero banner with wave background -->
            <FrameLayout
                android:id="@+id/categoryHeroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Wave background -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_top_wave" />

                <!-- Category name + count overlay on wave -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="56dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laptops"
                        android:textAppearance="@style/TextAppearance.App.ScreenTitle"
                        android:textColor="#000000"
                        android:textAlignment="center" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="124 Items"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="#000000"
                        android:textAlignment="center" />
                </LinearLayout>
            </FrameLayout>

            <!-- Brand filter chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/brandFilterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

            <!-- Result count label -->
            <LinearLayout
                android:id="@+id/resultsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/resultsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Showing all products"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary" />

                <!-- View mode toggle (grid / list) -->
                <RelativeLayout
                    android:id="@+id/viewModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/viewModeIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/event_list_24"
                        app:tint="@color/primary" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/sortButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:drawableStart="@drawable/ic_filter"
                    android:drawablePadding="4dp"
                    android:text="Filter &amp; Sort"
                    android:textAppearance="@style/TextAppearance.App.CardPrice"
                    android:textColor="@color/primary"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/chip_unselected" />
            </LinearLayout>

            <!-- Products grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detailProductsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingBottom="140dp"
                android:clipToPadding="false"
                android:background="@color/background"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
