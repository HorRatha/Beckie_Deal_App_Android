<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/brandCard"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/brandLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Brand icon/logo with circular background -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/category_icon_bg"
                android:backgroundTint="@color/cat_yellow">

                <!-- Brand logo image -->
                <ImageView
                    android:id="@+id/brandIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:contentDescription="Brand Logo" />

                <!-- Brand initial text (fallback) -->
                <TextView
                    android:id="@+id/brandIconText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_brown"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Brand name -->
            <TextView
                android:id="@+id/brandName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brand Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center" />

            <!-- Product count badge -->
            <TextView
                android:id="@+id/brandProductCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 products"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Selected checkmark badge, floats over the top-end corner of the card -->
    <ImageView
        android:id="@+id/selectedCheckBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/about_icon_circle_bg"
        android:backgroundTint="@color/primary"
        android:padding="4dp"
        android:src="@drawable/selected_check_badge"
        android:visibility="gone" />

    <!-- Icon container for compatibility -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
