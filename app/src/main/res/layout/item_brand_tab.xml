<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="68dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Brand logo -->
    <ImageView
        android:id="@+id/brandTabLogo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="Brand Logo" />

    <!-- Indicator bar (appears when selected) -->
    <View
        android:id="@+id/brandTabIndicator"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="@color/brand_orange"
        android:visibility="gone" />

    <!-- Empty space when not selected -->
    <View
        android:id="@+id/brandTabPlaceholder"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:visibility="visible" />

</LinearLayout>
