<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Progress Indicator Row centered vertically inside 90dp -->
    <LinearLayout
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Step 1 Circle -->
        <FrameLayout
            android:id="@+id/step1Circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/step_completed_circle_bg"
            android:backgroundTint="@null">

            <TextView
                android:id="@+id/step1Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Step 1 Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:text="Cart"
            android:textSize="12sp"
            android:textColor="@color/dark_brown" />

        <!-- Progress Line 1 -->
        <View
            android:id="@+id/progressLine1"
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:background="@color/button_toggle_inactive" />

        <!-- Step 2 Circle -->
        <FrameLayout
            android:id="@+id/step2Circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/login_logo_circle_bg"
            android:backgroundTint="@color/button_toggle_inactive">

            <TextView
                android:id="@+id/step2Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="2"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Step 2 Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:text="Shipping"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <!-- Progress Line 2 -->
        <View
            android:id="@+id/progressLine2"
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:background="@color/button_toggle_inactive" />

        <!-- Step 3 Circle -->
        <FrameLayout
            android:id="@+id/step3Circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/login_logo_circle_bg"
            android:backgroundTint="@color/button_toggle_inactive">

            <TextView
                android:id="@+id/step3Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="3"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Step 3 Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Payment"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- 🌟 Spinning Ring Overlay (60dp fits around 40dp circles) -->
    <aeu.ratha.beckie_deal_app.ui.components.AnimatedStepSpinnerView
        android:id="@+id/stepSpinnerView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:elevation="10dp" />
</FrameLayout>
