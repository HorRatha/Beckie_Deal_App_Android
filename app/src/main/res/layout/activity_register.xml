<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".RegisterActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Wave Section with Logo -->
            <FrameLayout
                android:id="@+id/registerHeaderWave"
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <!-- Curved gradient background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/login_header_wave_white" />

                <!-- Decorative circles -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-20dp"
                    android:layout_marginEnd="-40dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:alpha="0.15" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="-20dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:alpha="0.1" />

                <!-- Back button -->
                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="Back"
                    android:background="@drawable/login_logo_circle_bg"
                    android:elevation="4dp"
                    app:tint="@color/primary" />

                <!-- Logo with glow effect -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">
                    
                    <!-- Glow background -->
                    <View
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center"
                        android:background="@drawable/login_logo_glow" />

                    <!-- App Logo -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:src="@mipmap/ic_launcher"
                        android:elevation="8dp"
                        android:contentDescription="App Logo" />
                </FrameLayout>

                <!-- App name below logo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="20dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.App.PriceHero"
                    android:textColor="@color/white_fixed"
                    android:letterSpacing="0.05"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

            </FrameLayout>

            <!-- Form Card Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/registerFormSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/login_card_elevated_bg"
                    android:elevation="8dp"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="32dp">

                    <!-- Register Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Account"
                        android:textAppearance="@style/TextAppearance.App.ScreenTitle"
                        android:letterSpacing="0.02" />

                    <!-- Subtitle with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/login_logo_circle_bg"
                            android:backgroundTint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Sign up to get started"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <!-- First Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="First Name"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.03" />

                    <EditText
                        android:id="@+id/firstNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_person"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Enter your first name"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Last Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Last Name"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.03" />

                    <EditText
                        android:id="@+id/lastNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_person"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Enter your last name"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Email Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Email"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.03" />

                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_email"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Password Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Password"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.03" />

                    <EditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Min. 8 characters"
                        android:inputType="textPassword"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Confirm Password Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Confirm Password"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.03" />

                    <EditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Confirm your password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Terms Checkbox -->
                    <CheckBox
                        android:id="@+id/termsCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:button="@drawable/login_checkbox_selector"
                        android:paddingStart="8dp"
                        android:text="I agree to the Terms and Privacy Policy"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/text_secondary" />

                    <!-- Register Button -->
                    <Button
                        android:id="@+id/registerButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/login_button_white_bg"
                        android:text="Create Account"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColor="@color/white_fixed"
                        android:letterSpacing="0.05"
                        android:elevation="4dp"
                        android:stateListAnimator="@null" />

                    <!-- Login link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Already have an account? "
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/loginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Login"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/primary" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
