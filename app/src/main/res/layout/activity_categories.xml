<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".CategoriesActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_brown">

    <!-- Gradient hero header â€” continues the status bar color into the page and
         hosts the top bar + page title, replacing the flat white toolbar. -->
    <View
        android:id="@+id/heroGradient"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:background="@drawable/categories_hero_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_white_translucent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/white_fixed" />
            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="110dp"
                android:layout_height="36dp"
                android:layout_centerInParent="true"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:layout_toStartOf="@+id/notificationContainer"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_white_translucent"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/white_fixed" />
            <RelativeLayout
                android:id="@+id/notificationContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_white_translucent">

                <ImageView
                    android:id="@+id/notificationIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/white_fixed" />

                <TextView
                    android:id="@+id/notificationBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/badge_pill"
                    android:backgroundTint="@color/red_error"
                    android:gravity="center"
                    android:text="3"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textAllCaps="false"
                    android:textColor="@color/white_fixed"
                    android:visibility="visible" />

            </RelativeLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Page title + subtitle, sitting on the gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textColor="@color/dark_brown"
            android:textSize="@dimen/text_size_headline_large"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Explore our premium collection by hardware type"
            android:textColor="@color/dark_brown"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

    <!-- Scrollable Content â€” rounded-top sheet overlapping the gradient header -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@drawable/content_sheet_top_rounded"
        android:layout_marginTop="-22dp"
        app:layout_constraintTop_toBottomOf="@id/heroGradient"
        app:layout_constraintBottom_toTopOf="@id/bottomNavGlassHost">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="16dp">

            <!-- Laptops Brands Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section header row -->
                <LinearLayout
                    android:id="@+id/laptopBrandsSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/badge_bg"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/devices_24"
                            app:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laptop Brands"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/brandsAvailableSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="9 brands available"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/viewAllBrands"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/badge_bg"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="View All"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif-medium" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Brands Grid -->
                <GridLayout
                    android:id="@+id/laptopBrandsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />

            </LinearLayout>

            <!-- All Categories Section -->
            <TextView
                android:id="@+id/allCategoriesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="All Categories"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title_small"
                android:fontFamily="sans-serif-medium" />

            <GridLayout
                android:id="@+id/allCategoriesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>

<include layout="@layout/layout_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
