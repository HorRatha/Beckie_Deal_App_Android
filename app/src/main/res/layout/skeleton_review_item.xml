<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Product Image Skeleton -->
    <View
        android:id="@+id/productImageSkeleton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/skeleton_loading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Name Skeleton -->
    <View
        android:id="@+id/productNameSkeleton"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/skeleton_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/productImageSkeleton"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Rating Skeleton -->
    <View
        android:id="@+id/ratingSkeleton"
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/skeleton_loading"
        app:layout_constraintStart_toStartOf="@id/productNameSkeleton"
        app:layout_constraintTop_toBottomOf="@id/productNameSkeleton" />

    <!-- Comment Line 1 Skeleton -->
    <View
        android:id="@+id/commentLine1Skeleton"
        android:layout_width="0dp"
        android:layout_height="13dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/skeleton_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/productNameSkeleton"
        app:layout_constraintTop_toBottomOf="@id/ratingSkeleton" />

    <!-- Comment Line 2 Skeleton -->
    <View
        android:id="@+id/commentLine2Skeleton"
        android:layout_width="0dp"
        android:layout_height="13dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/skeleton_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/productNameSkeleton"
        app:layout_constraintTop_toBottomOf="@id/commentLine1Skeleton" />

</androidx.constraintlayout.widget.ConstraintLayout>
