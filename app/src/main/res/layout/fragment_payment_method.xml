<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 2 of 3: Payment Method"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_primary" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select your preferred payment method"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_secondary" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/paymentMethodsContainer">

            <!-- Payment methods will be added dynamically here -->

        </LinearLayout>

    </ScrollView>

    <!-- Button footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="12dp">

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/button_checkout_back_sharp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/white_fixed"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/button_pill_radius" />

        <!-- Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/button_checkout_continue_sharp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/dark_brown"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/button_pill_radius" />

    </LinearLayout>

</LinearLayout>
