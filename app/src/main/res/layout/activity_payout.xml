<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".PayoutActivity">

    <!-- Top Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            app:contentInsetStart="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/form_field_background"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="Back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Checkout"
                    android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            </RelativeLayout>

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/payoutContentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Shipping Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shipping Address"
                android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Recipient Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recipient Name *"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/shippingNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_field_background"
                        android:paddingHorizontal="16dp"
                        android:hint="Enter recipient name"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.App.CardProductName" />

                    <!-- Phone Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Phone Number *"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/shippingPhoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_field_background"
                        android:paddingHorizontal="16dp"
                        android:hint="+855 12 345 678"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.App.CardProductName" />

                    <!-- Street Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Street Address *"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/shippingAddressInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_field_background"
                        android:paddingHorizontal="16dp"
                        android:hint="Enter street address"
                        android:inputType="textPostalAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.App.CardProductName" />

                    <!-- City and Postal Code Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City *"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary" />

                            <EditText
                                android:id="@+id/shippingCityInput"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/form_field_background"
                                android:paddingHorizontal="16dp"
                                android:hint="Phnom Penh"
                                android:inputType="text"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textAppearance="@style/TextAppearance.App.CardProductName" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Postal Code *"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary" />

                            <EditText
                                android:id="@+id/shippingPostalCodeInput"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/form_field_background"
                                android:paddingHorizontal="16dp"
                                android:hint="12000"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textAppearance="@style/TextAppearance.App.CardProductName" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- State/Province (Optional) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="State / Province (Optional)"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/shippingStateInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_field_background"
                        android:paddingHorizontal="16dp"
                        android:hint="Kandal"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.App.CardProductName" />

                    <!-- Country -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Country"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/shippingCountryInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_field_background"
                        android:paddingHorizontal="16dp"
                        android:hint="Cambodia"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.App.CardProductName" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Payment Method"
                android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/form_field_background"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Credit Card"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="**** **** **** 4582"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:buttonTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Coupon Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Promo Code"
                android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/form_field_background"
                            android:padding="10dp"
                            android:src="@drawable/ic_discount_tag"
                            app:tint="@color/primary" />

                        <EditText
                            android:id="@+id/couponInput"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/form_field_background"
                            android:paddingHorizontal="16dp"
                            android:hint="Enter coupon code"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textAppearance="@style/TextAppearance.App.CardProductName" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/applyCouponButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:backgroundTint="@color/primary"
                            android:text="Apply"
                            android:textAllCaps="false"
                            android:textAppearance="@style/TextAppearance.App.Button"
                            android:textColor="@color/white_fixed"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <!-- Applied Coupon Display -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/appliedCouponCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/success_light_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check_circle_24"
                                app:tint="@color/green_stock" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/appliedCouponCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="WELCOME10"
                                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                                    android:textColor="@color/green_stock" />

                                <TextView
                                    android:id="@+id/appliedCouponDiscount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10% OFF"
                                    android:textAppearance="@style/TextAppearance.App.Body"
                                    android:textColor="@color/green_stock" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/removeCouponButton"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:padding="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_close"
                                app:tint="@color/green_stock" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Summary -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Order Summary"
                android:textAppearance="@style/TextAppearance.App.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Subtotal row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/summarySubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Discount row -->
                    <LinearLayout
                        android:id="@+id/discountRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Coupon Discount"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/summaryDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-$0.00"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/red_error" />
                    </LinearLayout>

                    <!-- Shipping Fee row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Shipping Fee"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/summaryShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$15.00"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/green_stock" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color"
                        android:layout_marginBottom="12dp" />

                    <!-- Total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/summaryTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$15.00"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Confirm Button Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="24dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmPaymentButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/button_add_to_cart_gradient"
                android:text="Confirm Payment"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.App.Button"
                android:textColor="@color/dark_brown"
                app:backgroundTint="@null" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Processing Overlay -->
    <FrameLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="100dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Processing Payment..."
                android:textAppearance="@style/TextAppearance.App.CardProductName"
                android:textColor="@color/white_fixed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Please wait a moment."
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/white_fixed"
                android:alpha="0.7" />
        </LinearLayout>
    </FrameLayout>

    <!-- Success View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/successView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:elevation="101dp"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="40dp">

            <!-- Soft glow ring behind the check badge -->
            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp">

                <View
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/success_check_outer_bg" />

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/success_check_inner_bg">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_bold_24"
                        android:contentDescription="Success" />

                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Payment Successful!"
                android:textAppearance="@style/TextAppearance.App.ProductName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your order has been placed. We'll notify you when it's on the way."
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/text_muted" />

            <!-- Order receipt summary card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/card_bg_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Order ID row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order ID"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/successOrderId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BD-1001"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_color" />

                    <!-- Amount Paid row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Amount Paid"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/successAmountPaid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_color" />

                    <!-- Payment Method row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payment Method"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="**** 4582"
                            android:textAppearance="@style/TextAppearance.App.CardProductName"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToHomeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/primary"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.App.Button"
                android:textColor="@color/white_fixed"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/white_fixed"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewOrdersButton"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="View My Orders"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.App.Button"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
