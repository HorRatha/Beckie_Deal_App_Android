<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_color"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:baselineAligned="false">

        <!-- Product image -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg_secondary">

            <ImageView
                android:id="@+id/cartItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:src="@drawable/placeholder_image" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Product info + quantity controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Name -->
            <TextView
                android:id="@+id/cartItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textAppearance="@style/TextAppearance.App.CardProductName"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Unit price -->
            <TextView
                android:id="@+id/cartItemUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$0.00 / unit"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <!-- Quantity stepper + subtotal row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:baselineAligned="false">

                <!-- Decrement -->
                <ImageView
                    android:id="@+id/cartItemDecrement"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/stepper_btn_outline"
                    android:src="@drawable/ic_minus_24"
                    android:scaleType="fitCenter"
                    android:contentDescription="Decrease quantity" />

                <!-- Quantity -->
                <TextView
                    android:id="@+id/cartItemQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="34dp"
                    android:gravity="center"
                    android:text="01"
                    android:textAppearance="@style/TextAppearance.App.CardPrice" />

                <!-- Increment -->
                <ImageView
                    android:id="@+id/cartItemIncrement"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/stepper_btn_filled"
                    android:src="@drawable/ic_plus_24"
                    android:scaleType="fitCenter"
                    android:contentDescription="Increase quantity" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Line subtotal -->
                <TextView
                    android:id="@+id/cartItemSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="$0.00"
                    android:textAppearance="@style/TextAppearance.App.SectionHeader"
                    android:textColor="@color/primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Remove button -->
        <ImageView
            android:id="@+id/cartItemRemove"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:padding="7dp"
            android:background="@drawable/cart_remove_bg"
            android:src="@drawable/ic_trash_24"
            android:scaleType="fitCenter"
            android:contentDescription="Remove from cart" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
