<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ProfileActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- â”€â”€ Gradient hero header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <View
        android:id="@+id/heroGradient"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:background="@drawable/categories_hero_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_white_translucent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/white_fixed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Profile"
                android:textColor="@color/white_fixed"
                android:textSize="@dimen/text_size_title_small"
                android:fontFamily="sans-serif-medium" />

            <RelativeLayout
                android:id="@+id/notificationContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_white_translucent">

                <ImageView
                    android:id="@+id/notificationIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/white_fixed" />

                <TextView
                    android:id="@+id/notificationBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/badge_pill"
                    android:backgroundTint="@color/red_error"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white_fixed"
                    android:textSize="@dimen/text_size_badge"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </RelativeLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- â•â• FIXED IDENTITY HEADER â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         Avatar + name + subtitle + auth buttons form ONE fixed block that sits
         half on the gradient, half on the white sheet below. It is a direct
         sibling in the outer ConstraintLayout (never inside the NestedScrollView),
         because ScrollView-family views clip overflowing content to their own
         bounds even with clipChildren=false â€” regular ViewGroups don't have that
         limitation, so the negative-margin overlap renders correctly here.
         The whole block stays fixed together (not just the avatar alone), so
         nothing looks like it's floating independently while the settings list
         scrolls beneath it. -->
    <LinearLayout
        android:id="@+id/profileHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/content_sheet_top_rounded"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingBottom="20dp"
        android:layout_marginTop="-28dp"
        app:layout_constraintTop_toBottomOf="@id/heroGradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Reserved space for the avatar, which is now drawn as a separate
                 top-level element below (see avatarOverlay), positioned last in
                 this file so it always renders above every other view with no
                 dependency on elevation/shadow rendering. -->
            <Space
                android:layout_width="1dp"
                android:layout_height="72dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Guest User"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sign in to sync your wishlist and orders"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <!-- â•â• AUTH BUTTONS â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/white_fixed"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:elevation="2dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold"
                app:backgroundTint="@color/badge_bg"
                app:cornerRadius="16dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- â”€â”€ Scrollable body â€” Account / Preferences / Legal settings lists only â”€â”€ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@color/background"
        app:layout_constraintTop_toBottomOf="@id/profileHeaderCard"
        app:layout_constraintBottom_toTopOf="@id/bottomNavGlassHost">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- â•â• ACCOUNT SECTION (My Orders + Notifications) â•â•â•â•â•â•â•â•â•â•â• -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Account"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- My Orders -->
                    <LinearLayout
                        android:id="@+id/ordersRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_1">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_orders"
                                app:tint="@color/brand_tint_fg_1" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="My Orders"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="3 active"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                    <!-- Notifications â€” Segmented Pill Toggle (ON / OFF) -->
                    <LinearLayout
                        android:id="@+id/notificationsRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_3">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/brand_tint_fg_3" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Notifications"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <!-- Modern Segmented Pill Toggle (ON / OFF) -->
                        <LinearLayout
                            android:id="@+id/notifToggleContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/notification_toggle_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <!-- ON option -->
                            <FrameLayout
                                android:id="@+id/notifOnOption"
                                android:layout_width="40dp"
                                android:layout_height="30dp"
                                android:background="@drawable/notification_pill_active"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/notifOnIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_toggle_on"
                                    app:tint="@color/white_fixed" />
                            </FrameLayout>

                            <!-- OFF option -->
                            <FrameLayout
                                android:id="@+id/notifOffOption"
                                android:layout_width="40dp"
                                android:layout_height="30dp"
                                android:background="@drawable/notification_pill_inactive"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/notifOffIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_toggle_off"
                                    app:tint="@color/text_secondary" />
                            </FrameLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â•â• PREFERENCES SECTION â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Preferences"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Language -->
                    <LinearLayout
                        android:id="@+id/languageRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_4">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_language"
                                app:tint="@color/brand_tint_fg_4" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Language"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="English"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                    <!-- Dark Mode â€” Segmented Pill Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_5">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_dark_mode"
                                app:tint="@color/brand_tint_fg_5" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Dark Mode"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <!-- Modern Segmented Pill Toggle (Sun / Moon) -->
                        <LinearLayout
                            android:id="@+id/darkModeToggleContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/dark_mode_toggle_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <!-- Light (Sun) option -->
                            <FrameLayout
                                android:id="@+id/lightModeOption"
                                android:layout_width="40dp"
                                android:layout_height="30dp"
                                android:background="@drawable/dark_mode_pill_active"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/lightModeIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sun"
                                    app:tint="@color/white_fixed" />
                            </FrameLayout>

                            <!-- Dark (Moon) option -->
                            <FrameLayout
                                android:id="@+id/darkModeOption"
                                android:layout_width="40dp"
                                android:layout_height="30dp"
                                android:background="@drawable/dark_mode_pill_inactive"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/darkModeIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_moon"
                                    app:tint="@color/text_secondary" />
                            </FrameLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â•â• LEGAL SECTION â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Legal"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- About Us -->
                    <LinearLayout
                        android:id="@+id/aboutUsRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_2">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_info"
                                app:tint="@color/brand_tint_fg_2" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="About Us"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                    <!-- Privacy Policy -->
                    <LinearLayout
                        android:id="@+id/privacyRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_6">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_privacy"
                                app:tint="@color/brand_tint_fg_6" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Privacy Policy"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_color" />

                    <!-- Terms of Service -->
                    <LinearLayout
                        android:id="@+id/termsRow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/brand_tint_bg_1">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_terms"
                                app:tint="@color/brand_tint_fg_1" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Terms of Service"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- â•â• VERSION FOOTER â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@mipmap/ic_launcher"
                    android:alpha="0.5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Beckie Deal"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Version 1.0.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- â•â• FLOATING AVATAR â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         Deliberately placed LAST in this ConstraintLayout (drawn after the
         hero, toolbar, header card and scrolling content) so it always
         renders on top of everything with plain view stacking order â€” no
         dependency on elevation/shadow rendering, which was inconsistent
         on-device. A MaterialCardView is used instead of a shape drawable
         because its cardElevation/shadow already rendered correctly for the
         edit-pencil badge; the colored stroke ring also guarantees the
         avatar reads as "elevated" even if shadows don't render at all. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/avatarOverlay"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="12dp"
        app:strokeWidth="4dp"
        app:strokeColor="@color/primary"
        app:cardBackgroundColor="@color/card_bg_secondary"
        android:layout_marginTop="-60dp"
        app:layout_constraintTop_toBottomOf="@id/heroGradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/avatarIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/editAvatarButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/surface"
        app:cardBackgroundColor="@color/primary"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        app:layout_constraintBottom_toBottomOf="@id/avatarOverlay"
        app:layout_constraintEnd_toEndOf="@id/avatarOverlay">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_edit_profile" />
    </com.google.android.material.card.MaterialCardView>

    <!-- â”€â”€ Floating bottom nav â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>

<include layout="@layout/layout_drawer" />

