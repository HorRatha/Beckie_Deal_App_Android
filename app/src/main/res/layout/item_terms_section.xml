<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/termHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/termNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/badge_circle"
            android:backgroundTint="@color/badge_bg"
            android:gravity="center"
            android:text="1"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/termTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Section title"
            android:textAppearance="@style/TextAppearance.App.CardProductName"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/termIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="+"
            android:textColor="@color/brand_orange"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/termBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="68dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:text=""
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="6dp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />
</LinearLayout>
