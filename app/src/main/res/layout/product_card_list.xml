<?xml version="1.0" encoding="utf-8"?>
<!--
    Beckie Deal — Product Card (1-column list row)
    Horizontal layout: square thumbnail on the left, details on the right.
    Shares the same view IDs as product_card.xml so ProductCardBinder works unchanged.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ── Product image — fixed square thumbnail ─────────────────── -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@color/card_bg_secondary">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image" />

            <!-- Wishlist — semi-transparent pill, top-right -->
            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/favorite_background"
                android:padding="5dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_secondary" />

        </FrameLayout>

        <!-- ── Hairline divider ───────────────────────────────────────── -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_color" />

        <!-- ── Info section — grows to fill remaining width ──────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Product title -->
            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Variant line (memory / storage / colour) -->
            <TextView
                android:id="@+id/productVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Stock status -->
            <TextView
                android:id="@+id/stockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Available In Stock"
                android:textColor="#1565C0"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <!-- Warranty -->
            <TextView
                android:id="@+id/warrantyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1 Year Warranty"
                android:textColor="#2E7D32"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <!-- SKU -->
            <TextView
                android:id="@+id/skuText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#00897B"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Price -->
            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="$0"
                android:textColor="@color/red_error"
                android:textSize="@dimen/text_size_title_small"
                android:textStyle="bold" />

            <!-- Specs bullets -->
            <TextView
                android:id="@+id/productSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Free items -->
            <TextView
                android:id="@+id/freeItemsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/red_error"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="italic"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
