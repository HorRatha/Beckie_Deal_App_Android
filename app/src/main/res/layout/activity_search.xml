<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ── Top bar with real search input ─────────────────────────────────── -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/topbar_yellow_transparent"
        app:elevation="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/form_field_background"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="Back"
                app:tint="@color/text_primary" />

            <!-- Search input field -->
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_toEndOf="@+id/backButton"
                android:layout_toStartOf="@+id/clearButton"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/search_background"
                android:hint="Search products, brands, categories..."
                android:textColorHint="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:paddingStart="44dp"
                android:paddingEnd="12dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <!-- Clear button -->
            <ImageView
                android:id="@+id/clearButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@+id/viewModeButton"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="@drawable/form_field_background"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:visibility="gone" />

            <!-- View mode toggle (grid / list) -->
            <RelativeLayout
                android:id="@+id/viewModeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/form_field_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/viewModeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/event_list_24"
                    app:tint="@color/text_secondary" />

            </RelativeLayout>

        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Discovery / Idle State Layout (Curated Categories & Trending Searches) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/discoveryScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="120dp">

            <!-- Trending Searches Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending Searches"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/trendingChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <!-- Curated Categories Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Curated Categories"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Categories Chip Group Container (Pill buttons, no image) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoriesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Products grid (scrollable results) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/resultsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:id="@+id/resultsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="140dp"
            android:background="@color/border_color"
            android:columnCount="2"
            android:clipToPadding="false" />

    </androidx.core.widget.NestedScrollView>

    <!-- Empty / placeholder state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/text_secondary"
            android:alpha="0.4"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No products found"
            android:textAppearance="@style/TextAppearance.App.CardProductName"
            android:gravity="center" />

        <TextView
            android:id="@+id/emptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Try searching with a different keyword or category"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

    <!-- Floating Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
