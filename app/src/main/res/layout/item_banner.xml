<?xml version="1.0" encoding="utf-8"?>
<!-- Single banner slide for ViewPager2 carousel -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full background (gradient or image) -->
    <View
        android:id="@+id/bannerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Banner image - full size as background -->
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <!-- Dark overlay for better text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/banner_overlay" />

    <!-- Text content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <!-- Tag/label pill -->
        <TextView
            android:id="@+id/bannerTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_arrow_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="HOT DEAL"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_overline"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Title -->
        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Summer Sale"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/bannerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Up to 50% off"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_body"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

    </LinearLayout>

</FrameLayout>
