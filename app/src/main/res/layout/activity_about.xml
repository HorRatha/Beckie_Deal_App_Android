<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".AboutActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- Top App Bar (unchanged) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/topbar_yellow_transparent"
            android:elevation="0dp"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="Back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="About Us"
                    android:textAppearance="@style/TextAppearance.App.SectionHeader" />

                <RelativeLayout
                    android:id="@+id/notificationContainer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/notificationIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/dark_brown" />

                    <TextView
                        android:id="@+id/notificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/badge_pill"
                        android:backgroundTint="@color/red_error"
                        android:gravity="center"
                        android:text="3"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/white_fixed"
                        android:visibility="visible" />
                </RelativeLayout>
            </RelativeLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/aboutContentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintBottom_toTopOf="@id/bottomNavGlassHost">

            <!-- CHANGED: no side padding here, so the hero image can go edge to edge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- ══ NEW: full-width image hero with title on top ══ -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@color/card_bg_secondary">

                    <ImageView
                        android:id="@+id/aboutUsImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/placeholder_image"
                        android:contentDescription="About Us - Beckie Deal Cambodia" />

                    <!-- Dark fade so the white text stays readable -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/category_card_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="60dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/yellow_star"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="About Us"
                            android:textAppearance="@style/TextAppearance.App.Label"
                            android:textAllCaps="false"
                            android:textColor="@color/dark_brown" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Beckie Deal Cambodia"
                            android:textAppearance="@style/TextAppearance.App.ScreenTitle"
                            android:textColor="@color/dark_brown" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bringing innovation first to Cambodia"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_secondary"
                            android:alpha="0.95" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ══ NEW: stats card floating over the bottom of the image ══ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-26dp"
                    android:layout_marginHorizontal="20dp"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_color"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="@drawable/brand_bar_gradient" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Stat 1: Official Products -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textAppearance="@style/TextAppearance.App.ScreenTitle"
                                    android:textColor="@color/brand_orange"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Official Products"
                                    android:textAppearance="@style/TextAppearance.App.Body"
                                    android:textColor="@color/text_secondary"
                                    android:fontFamily="@font/khmer_font" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="@color/border_color" />

                            <!-- Stat 2: Guaranteed -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@android:drawable/btn_star_big_on"
                                        android:contentDescription="Guaranteed"
                                        app:tint="@color/yellow_star" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Guaranteed"
                                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                                        android:textColor="@color/dark_brown" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Official Partner"
                                    android:textAppearance="@style/TextAppearance.App.Body"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Everything below keeps the original 20dp side padding -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <!-- Mission text (unchanged) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Beckie Deal តែងតែនាំមកផលិតផលថ្មីៗ មុនគេនៅក្នុងប្រទេសកម្ពុជា។\nសូមទំនាក់ទំនងផ្នែកលក់របស់ Beckie Deal Cambodia។"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="6dp" />

                    <!-- New Products First badge (unchanged) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/about_card_gradient_border"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/about_icon_bg_gradient"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@android:drawable/ic_menu_upload"
                                android:contentDescription="New Products"
                                app:tint="@color/dark_brown" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New Products First"
                                android:textAppearance="@style/TextAppearance.App.CardProductName"
                                android:textColor="@color/dark_brown" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Always first in Cambodia."
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ══════════ ACCORDION 1: Warranty Terms ══════════ -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:background="@color/border_color" />

                    <LinearLayout
                        android:id="@+id/accWarrantyHeader"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:background="@color/brand_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="លក្ខខណ្ឌការធានា / Warranty Terms"
                            android:textAppearance="@style/TextAppearance.App.ProductName"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/accWarrantyIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="@color/brand_orange"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/accWarrantyBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <!-- Khmer warranty block (text unchanged) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border_color">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:background="@color/surface">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="• រាល់ Password Log-in សំរាប់ម៉ាសុីនទិញថ្មី setup រួចគឺ : 1234\n• រាល់ទំនិញទិញរួចមិនអាចប្ដូរ ឬ ដូរវិញបានឡើយ\n• ធានាលើគ្រឿងបន្លាស់តាមរយៈពេលដែលបានកំណត់\n• មិនធានាលើរបស់ដែលថែមជូន\n• មិនធានាលើទំនិញដែលបាត់បង់លក្ខណៈដើម ឆេះ ធ្លាក់ បាក់បែក ចូលទឹក និងបាត់/រហែក Warranty Seal\n• រាល់ឥវ៉ាន់របស់ ASUS/MSI Cambodia គឺធានាទៅតាមលក្ខខ័ណ្ឌរបស់ក្រុមហ៊ុន\n• សម្រាប់ Apple ជាប់ iCloud ដែលធ្វើអោយការធានាបញ្ជូនត្រលប់មកវិញ ដូច្នេះការធានាទុកជាមោឃៈ\n• រាល់ផលិតផល Gaming Laptop (VGA ដាច់) មិនធានាលើដុំសាក និង អេក្រង់\n• រយៈពេលនៃការធ្វើ Warranty ពេលជួបបញ្ហា អាចចន្លោះពី 2-6 សប្តាហ៍\n• ក្រដាសនេះមិនអាចយកទៅប្រកាសពន្ធបានទេ"
                                    android:textAppearance="@style/TextAppearance.App.Specs"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- English warranty block (text unchanged) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border_color">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:background="@color/surface">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="• Password Log in After Setup : 1234\n• Goods are sold — no refund and return.\n• Warranty covers parts according to the specified period.\n• Extra Free Items are not under Warranty.\n• No Warranty on Adapter / Lost / Broken / Damage / Water-Damage or Missing Warranty Seal.\n• ASUS/MSI Cambodia products are warranted according to the company\'s terms and conditions.\n• For Apple devices with iCloud lock, the warranty return will be voided.\n• Gaming Laptop (GPU) — Not Warranty on Screen and Adapter.\n• Warranty processing time in case of issues can range from 2 to 6 weeks.\n• VAT is not included in this invoice / Cannot be used for Tax Declaration."
                                    android:textAppearance="@style/TextAppearance.App.Specs"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- ══════════ ACCORDION 2: Contact Us ══════════ -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color" />

                    <LinearLayout
                        android:id="@+id/accContactHeader"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:background="@color/brand_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="ទំនាក់ទំនងមកយើង / Contact Us"
                            android:textAppearance="@style/TextAppearance.App.ProductName"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/accContactIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="@color/brand_orange"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/accContactBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="សូមទំនាក់ទំនងតាមរយះទូរស័ព្ទ ឬ ផ្ញើសាររបស់លោកអ្នកមកយើង។"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="4dp" />

                        <!-- Contact Form Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border_color">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:background="@color/surface">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ឈ្មោះ / Full Name"
                                    android:textAppearance="@style/TextAppearance.App.Label"
                                    android:textAllCaps="false"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/inputName"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/form_field_background"
                                    android:hint="John Doe"
                                    android:textColorHint="@color/text_muted"
                                    android:textColor="@color/text_primary"
                                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                                    android:paddingHorizontal="16dp"
                                    android:inputType="textPersonName"
                                    android:importantForAutofill="no" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="អ៊ីម៉ែល / Email Address"
                                    android:textAppearance="@style/TextAppearance.App.Label"
                                    android:textAllCaps="false"
                                    android:textColor="@color/text_secondary"
                                    android:fontFamily="@font/khmer_font" />

                                <EditText
                                    android:id="@+id/inputEmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/form_field_background"
                                    android:hint="john@example.com"
                                    android:textColorHint="@color/text_muted"
                                    android:textColor="@color/text_primary"
                                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                                    android:paddingHorizontal="16dp"
                                    android:inputType="textEmailAddress"
                                    android:importantForAutofill="no" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="សាររបស់អ្នក / Message"
                                    android:textAppearance="@style/TextAppearance.App.Label"
                                    android:textAllCaps="false"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/inputMessage"
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/form_field_background"
                                    android:hint="How can we assist you today?"
                                    android:textColorHint="@color/text_muted"
                                    android:textColor="@color/text_primary"
                                    android:textAppearance="@style/TextAppearance.App.CardProductName"
                                    android:padding="16dp"
                                    android:inputType="textMultiLine"
                                    android:gravity="top|start"
                                    android:importantForAutofill="no" />

                                <Button
                                    android:id="@+id/btnSubmit"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:layout_marginTop="24dp"
                                    android:background="@drawable/about_submit_button_gradient"
                                    android:text="Submit Message ➤"
                                    android:textAppearance="@style/TextAppearance.App.Button"
                                    android:textColor="@color/white_fixed"
                                    android:stateListAnimator="@null"
                                    android:elevation="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Phone Support (unchanged) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/about_card_gradient_border"
                            android:orientation="horizontal"
                            android:padding="20dp"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/about_icon_bg_gradient"
                                android:gravity="center">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_phone"
                                    android:contentDescription="Phone"
                                    app:tint="@color/dark_brown" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
