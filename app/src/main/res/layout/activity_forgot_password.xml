<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_radial_gradient_bg"
    android:fitsSystemWindows="true"
    tools:context=".ForgotPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section with Logo -->
            <FrameLayout
                android:id="@+id/forgotPasswordHeaderWave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- Back button -->
                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:contentDescription="Back"
                    android:elevation="4dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/primary" />

                <!-- Logo - Small and Wide Format -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/logo_light"
                        android:scaleType="fitCenter"
                        android:contentDescription="Beckie Deal Logo" />

                </LinearLayout>

            </FrameLayout>

            <!-- Progress Indicator -->
            <LinearLayout
                android:id="@+id/progressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Step 1 Circle -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:backgroundTint="@color/primary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="1"
                        android:textColor="@color/dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Progress Line -->
                <View
                    android:id="@+id/progressLine"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/button_toggle_inactive" />

                <!-- Step 2 Circle -->
                <FrameLayout
                    android:id="@+id/step2Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:backgroundTint="@color/button_toggle_inactive">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="2"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- Form Card Section with FrameLayout for step transitions -->
            <FrameLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <!-- Step 1: Email Input Form -->
                <LinearLayout
                    android:id="@+id/step1EmailForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:elevation="8dp"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:background="@drawable/login_input_background_white">

                    <!-- Step 1 Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset Your Password"
                        android:textAppearance="@style/TextAppearance.App.AuthTitle"
                        android:textColor="@color/dark_brown" />

                    <!-- Subtitle with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/login_logo_circle_bg"
                            android:backgroundTint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Enter your email to receive a reset code"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />
                    </LinearLayout>

                    <!-- Instruction Text -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="We'll send you a verification code to your registered email address so you can reset your password."
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.3" />

                    <!-- Email Field Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Email Address"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- Email Input -->
                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_email"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Error Message for Email -->
                    <TextView
                        android:id="@+id/emailErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Send Code Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sendCodeButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/login_button_rounded_bg"
                        app:backgroundTint="@null"
                        android:text="Send Reset Code"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:elevation="4dp"
                        android:stateListAnimator="@null" />

                    <!-- Back to Login Link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remember your password? "
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/backToLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Back to Login"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 2: OTP & Password Reset Form -->
                <LinearLayout
                    android:id="@+id/step2OtpForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:elevation="8dp"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:background="@drawable/login_input_background_white"
                    android:visibility="gone">

                    <!-- Step 2 Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify &amp; Reset"
                        android:textAppearance="@style/TextAppearance.App.AuthTitle"
                        android:textColor="@color/dark_brown" />

                    <!-- Subtitle with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/login_logo_circle_bg"
                            android:backgroundTint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Enter the code sent to your email"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />
                    </LinearLayout>

                    <!-- Email Display Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:background="@color/button_toggle_inactive"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            android:contentDescription="Email"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/emailDisplayText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="user@example.com"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown" />

                    </LinearLayout>

                    <!-- OTP Input Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Verification Code"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- OTP Input Fields Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:spacing="8dp">

                        <!-- OTP Digit 1 -->
                        <EditText
                            android:id="@+id/otpDigit1"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                        <!-- OTP Digit 2 -->
                        <EditText
                            android:id="@+id/otpDigit2"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                        <!-- OTP Digit 3 -->
                        <EditText
                            android:id="@+id/otpDigit3"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                        <!-- OTP Digit 4 -->
                        <EditText
                            android:id="@+id/otpDigit4"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                        <!-- OTP Digit 5 -->
                        <EditText
                            android:id="@+id/otpDigit5"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                        <!-- OTP Digit 6 -->
                        <EditText
                            android:id="@+id/otpDigit6"
                            android:layout_width="45dp"
                            android:layout_height="50dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/login_input_background_white"
                            android:text=""
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_brown"
                            android:textColorHint="@color/text_muted"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1" />

                    </LinearLayout>

                    <!-- Error Message for OTP -->
                    <TextView
                        android:id="@+id/otpErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- New Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="New Password"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- New Password Input -->
                    <EditText
                        android:id="@+id/newPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Min. 8 characters"
                        android:inputType="textPassword"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Confirm Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Confirm Password"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- Confirm Password Input -->
                    <EditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/login_input_background_white"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="14dp"
                        android:hint="Confirm your password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="18dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColorHint="@color/text_muted" />

                    <!-- Error Message for Password -->
                    <TextView
                        android:id="@+id/passwordErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Reset Password Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/resetPasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/login_button_rounded_bg"
                        app:backgroundTint="@null"
                        android:text="Reset Password"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:elevation="4dp"
                        android:stateListAnimator="@null" />

                    <!-- Resend OTP Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't receive the code? "
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/resendOtpLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown"
                            android:paddingHorizontal="4dp" />

                    </LinearLayout>

                    <!-- Resend Timer -->
                    <TextView
                        android:id="@+id/resendTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Resend in 60s"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
