<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_radial_gradient_bg"
    android:fitsSystemWindows="true"
    tools:context=".ForgotPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Header Section with Logo (unchanged) -->
            <FrameLayout
                android:id="@+id/forgotPasswordHeaderWave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:contentDescription="Back"
                    android:elevation="4dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="Beckie Deal Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_light" />
                </LinearLayout>
            </FrameLayout>

            <!-- Progress Indicator Parent Container (Set height to 60dp so 54dp spinner fits fully) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Progress Indicator Row centered vertically inside 60dp -->
                <LinearLayout
                    android:id="@+id/progressIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/step1Circle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/step_completed_circle_bg"
                        android:backgroundTint="@null">

                        <TextView
                            android:id="@+id/step1Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <View
                        android:id="@+id/progressLine"
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/button_toggle_inactive" />

                    <FrameLayout
                        android:id="@+id/step2Circle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/login_logo_circle_bg"
                        android:backgroundTint="@color/button_toggle_inactive">

                        <TextView
                            android:id="@+id/step2Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 🌟 Spinning Ring Overlay (54dp fits completely inside 60dp) -->
                <aeu.ratha.beckie_deal_app.ui.components.AnimatedStepSpinnerView
                    android:id="@+id/stepSpinnerView"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:elevation="10dp" />
            </FrameLayout>

            <!-- Form section: NO card, fields sit on the background -->
            <FrameLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <!-- ═════════════ Step 1: Email ═════════════ -->
                <LinearLayout
                    android:id="@+id/step1EmailForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Step 1 Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset Your Password"
                        android:textAppearance="@style/TextAppearance.App.AuthTitle"
                        android:textColor="@color/dark_brown" />

                    <!-- Subtitle with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/login_logo_circle_bg"
                            android:backgroundTint="@color/dark_brown" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Enter your email to receive a reset code"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />
                    </LinearLayout>

                    <!-- Instruction Text -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:alpha="0.8"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We'll send you a verification code to your registered email address so you can reset your password."
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/dark_brown" />

                    <!-- Email Field Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Email Address"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- Email Input -->
                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawablePadding="12dp"
                        android:drawableStart="@drawable/ic_email"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="2dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <!-- Error Message for Email -->
                    <TextView
                        android:id="@+id/emailErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Send Code Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sendCodeButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/forgot_password_button_bg"
                        android:elevation="4dp"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null"
                        android:text="Send Reset Code"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Back to Login Link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:text="Remember your password? "
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />

                        <TextView
                            android:id="@+id/backToLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Back to Login"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ═════════════ Step 2: Verify & Reset ═════════════ -->
                <LinearLayout
                    android:id="@+id/step2OtpForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Step 2 Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify &amp; Reset"
                        android:textAppearance="@style/TextAppearance.App.AuthTitle"
                        android:textColor="@color/dark_brown" />

                    <!-- Subtitle with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/login_logo_circle_bg"
                            android:backgroundTint="@color/dark_brown" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Enter the code sent to your email"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />
                    </LinearLayout>

                    <!-- Email display: underline row + Change link -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_underline_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp"
                        android:paddingHorizontal="2dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Email"
                            android:src="@drawable/ic_email"
                            app:tint="@color/dark_brown" />

                        <TextView
                            android:id="@+id/emailDisplayText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="user@example.com"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown" />

                        <!-- NEW (optional): goes back to step 1 -->
                        <TextView
                            android:id="@+id/changeEmailLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="Change"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- OTP Input Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Verification Code"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- OTP Input Fields Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- OTP Digit 1 -->
                        <EditText
                            android:id="@+id/otpDigit1"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP Digit 2 -->
                        <EditText
                            android:id="@+id/otpDigit2"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP Digit 3 -->
                        <EditText
                            android:id="@+id/otpDigit3"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP Digit 4 -->
                        <EditText
                            android:id="@+id/otpDigit4"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP Digit 5 -->
                        <EditText
                            android:id="@+id/otpDigit5"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP Digit 6 -->
                        <EditText
                            android:id="@+id/otpDigit6"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text=""
                            android:textColor="@color/dark_brown"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Error Message for OTP -->
                    <TextView
                        android:id="@+id/otpErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- New Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="New Password"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- New Password Input -->
                    <EditText
                        android:id="@+id/newPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawablePadding="12dp"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Min. 8 characters"
                        android:inputType="textPassword"
                        android:paddingHorizontal="2dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <!-- Confirm Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Confirm Password"
                        android:textAppearance="@style/TextAppearance.App.CardPrice"
                        android:textColor="@color/dark_brown" />

                    <!-- Confirm Password Input -->
                    <EditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawablePadding="12dp"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Confirm your password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="2dp"
                        android:textAppearance="@style/TextAppearance.App.CardProductName"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <!-- Error Message for Password -->
                    <TextView
                        android:id="@+id/passwordErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Reset Password Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/resetPasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/forgot_password_button_bg"
                        android:elevation="4dp"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null"
                        android:text="Reset Password"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Resend OTP Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:text="Didn't receive the code? "
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/dark_brown" />

                        <TextView
                            android:id="@+id/resendOtpLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="4dp"
                            android:text="Resend"
                            android:textAppearance="@style/TextAppearance.App.CardPrice"
                            android:textColor="@color/dark_brown" />
./
                    </LinearLayout>

                    <!-- Resend Timer -->
                    <TextView
                        android:id="@+id/resendTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.75"
                        android:text="Resend in 60s"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/dark_brown"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Progress Bar (unchanged) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
