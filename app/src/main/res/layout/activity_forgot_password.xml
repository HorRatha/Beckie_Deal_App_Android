<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_radial_gradient_bg"
    android:fitsSystemWindows="true"
    tools:context=".ForgotPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section with Logo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/login_logo_circle_bg"
                    android:contentDescription="Back"
                    android:elevation="4dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="Beckie Deal Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_light" />
                </LinearLayout>
            </FrameLayout>

            <!-- Progress Indicator (Step 1, 2, 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="40dp">

                <!-- Step 1 Circle -->
                <FrameLayout
                    android:id="@+id/step1Circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/login_button_rounded_bg"
                    android:backgroundTint="@color/dark_brown">

                    <TextView
                        android:id="@+id/step1Number"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Progress Line 1 -->
                <View
                    android:id="@+id/progressLine1"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/text_muted" />

                <!-- Step 2 Circle -->
                <FrameLayout
                    android:id="@+id/step2Circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/login_button_rounded_bg"
                    android:backgroundTint="@color/text_muted">

                    <TextView
                        android:id="@+id/step2Number"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Progress Line 2 -->
                <View
                    android:id="@+id/progressLine2"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/text_muted" />

                <!-- Step 3 Circle -->
                <FrameLayout
                    android:id="@+id/step3Circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/login_button_rounded_bg"
                    android:backgroundTint="@color/text_muted">

                    <TextView
                        android:id="@+id/step3Number"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Lottie Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/forgotPasswordAnimation"
                android:layout_width="218dp"
                android:layout_height="215dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/forget_password" />

            <!-- Form Container with 3 Steps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="32dp">

                <!-- STEP 1: Email Input -->
                <LinearLayout
                    android:id="@+id/step1EmailForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset Your Password"
                        android:textSize="18sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Enter your email address to receive a reset code"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Email Address"
                        android:textSize="13sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawableStart="@drawable/ic_email"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="2dp"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <TextView
                        android:id="@+id/emailErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sendCodeButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/forgot_password_button_bg"
                        android:text="Send Reset Code"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- STEP 2: OTP Verification -->
                <LinearLayout
                    android:id="@+id/step2OtpForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify Your Code"
                        android:textSize="18sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Enter the 6-digit code sent to your email"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_underline_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            android:contentDescription="Email"
                            app:tint="@color/dark_brown" />

                        <TextView
                            android:id="@+id/emailDisplayText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="user@example.com"
                            android:textSize="13sp"
                            android:textColor="@color/dark_brown"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/changeEmailLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change"
                            android:textSize="13sp"
                            android:textColor="@color/dark_brown"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Verification Code"
                        android:textSize="13sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/otpDigit1"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/otpDigit2"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/otpDigit3"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/otpDigit4"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/otpDigit5"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/otpDigit6"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_underline_field"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/dark_brown"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/otpErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/resendOtpLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend Code"
                            android:textSize="13sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/resendTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Resend in 60s"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/verifyCodeButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/forgot_password_button_bg"
                        android:text="Next"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- STEP 3: New Password -->
                <LinearLayout
                    android:id="@+id/step3PasswordForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create New Password"
                        android:textSize="18sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Enter a strong password for your account"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="New Password"
                        android:textSize="13sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/newPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Min. 8 characters"
                        android:inputType="textPassword"
                        android:paddingHorizontal="2dp"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Confirm Password"
                        android:textSize="13sp"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_underline_field"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/dark_brown"
                        android:hint="Confirm your password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="2dp"
                        android:textColor="@color/dark_brown"
                        android:textColorHint="@color/form_hint" />

                    <TextView
                        android:id="@+id/passwordErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/resetPasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/forgot_password_button_bg"
                        android:text="Reset Password"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
