<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- Section header row -->
    <LinearLayout
        android:id="@+id/brandTabsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/badge_bg"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/devices_24"
                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laptop Brands"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/brandTabsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="6 brands available"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/viewAllBrandsBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/badge_bg"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="See More"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="sans-serif-medium" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Horizontal scrollable brand tabs -->
    <HorizontalScrollView
        android:id="@+id/brandTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/brandTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- Product preview section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <!-- Preview header row with "See all >" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/previewHeaderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apple - 12 products"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/seeAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all ›"
                android:textColor="@color/brand_orange"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Horizontal scrollable brand product suggestions/preview -->
        <HorizontalScrollView
            android:id="@+id/brandProductsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/previewProductsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Loading state (shown while fetching products) -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading products..."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <!-- Empty state (shown when brand has no products) -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_category"
                android:layout_marginBottom="8dp"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coming soon"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
