<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified compact category chip design -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Category icon with circular background -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/categoryCard"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_color"
        app:cardBackgroundColor="@color/surface">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/category_icon_bg_gradient">

            <ImageView
                android:id="@+id/categoryIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/dark_brown" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Category name below icon -->
    <TextView
        android:id="@+id/categoryName"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Category"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="normal" />

    <!-- Hidden decorative icon for compatibility -->
    <ImageView
        android:id="@+id/categoryDecorativeIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
