<?xml version="1.0" encoding="utf-8"?>
<!--
    Beckie Deal — Product Card (2-column grid) — Fact Grid style
    Flat, no border, no shadow, no rounded corners. Full-bleed image.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/product_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Product image ──────────────────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:background="@color/card_bg_secondary">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image" />

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/favorite_background"
                android:padding="5dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quickAddToCartButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/yellow_star">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/add_shopping_cart_24"
                    app:tint="@color/dark_brown" />
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- ── Brand bar (replaces the hairline divider) ──────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/brand_bar_gradient" />

        <!-- ── Info section ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Product title -->
            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textAppearance="@style/TextAppearance.App.CardProductName"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Variant / weight line -->
            <TextView
                android:id="@+id/productVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- ── Fact grid: Stock | Warranty ────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fact_grid"
                android:orientation="horizontal">

                <!-- Stock cell -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stock"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/stockStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Available"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="#1565C0"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Vertical divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border_color" />

                <!-- Warranty cell -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Warranty"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/warrantyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1 Year"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="#2E7D32"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>

            <!-- SKU -->
            <TextView
                android:id="@+id/skuText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="#00897B"
                android:visibility="gone" />

            <!-- Price -->
            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="$0"
                android:textAppearance="@style/TextAppearance.App.CardPrice"
                android:textSize="17sp"
                android:textColor="@color/red_error" />

            <!-- Specs bullets -->
            <TextView
                android:id="@+id/productSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.App.Specs"
                android:maxLines="4"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Free items -->
            <TextView
                android:id="@+id/freeItemsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textAllCaps="false"
                android:textColor="@color/red_error"
                android:textStyle="italic"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>