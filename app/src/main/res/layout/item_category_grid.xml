<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="@dimen/category_card_height"
    android:layout_columnWeight="1"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#1A1A2E">

    <!-- Background image (loaded via Glide in code) -->
    <ImageView
        android:id="@+id/categoryBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Dark gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/category_card_gradient" />

    <!-- HOT badge top-left -->
    <TextView
        android:id="@+id/hotBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/badge_pill"
        android:backgroundTint="@color/primary"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="HOT"
        android:textColor="@color/white_fixed"
        android:textSize="@dimen/text_size_badge"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Category icon top-right -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:strokeWidth="0dp">
        <ImageView
            android:id="@+id/categorySmallIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/devices_24"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title + count bottom-left -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laptops"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/categoryItemsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="124 Items"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
