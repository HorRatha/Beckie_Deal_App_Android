<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_bg_secondary">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/categoryImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image" />

        <!-- Dark fade so the label stays readable -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/category_card_scrim" />

        <!-- Item count chip (top-left) -->
        <TextView
            android:id="@+id/categoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#E6FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="0 items"
            android:textColor="@color/dark_brown"
            android:textSize="@dimen/text_size_caption" />

        <!-- Category icon (top-right) -->
        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            app:tint="@color/white_fixed" />

        <!-- Yellow name tag (bottom-left) -->
        <TextView
            android:id="@+id/categoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@color/yellow_star"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Category"
            android:textColor="@color/dark_brown"
            android:textSize="@dimen/text_size_caption" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
